# AI Finance Controller - Environment Configuration
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DB_PASSWORD=your_postgres_password

# AI Provider: ollama | groq | mock
# For Ollama (local, free): ollama pull llama3.1:8b
# For Groq (cloud, free tier): get API key from https://console.groq.com
AI_PROVIDER=ollama

# Ollama Configuration (if using ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq Configuration (if using groq)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Application
APP_DEBUG=false
APP_SECRET_KEY=your_random_secret_key_here